# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Never commit the real secrets.toml.

EMAIL_MODE = "smtp"                 # "file" = save e-mails to ./outbox, "smtp" = really send
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your.test.account@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"   # Gmail App Password (not your normal password)
SENDER = "your.test.account@gmail.com"

APP_BASE_URL = "https://your-app-name.streamlit.app"   # used to build the link in each e-mail

# Cost parameters (IDR/kWh)
C_AVOIDED = 1500        # placeholder until PLN BPP figure is confirmed
C_AVOIDABLE = 2454.85   # PLTG average total operating cost (Table 1 in the report)
